# Quadlet: Caddy (Server 2, 192.168.1.48)
# Salin ke /etc/containers/systemd/caddy.container lalu: systemctl daemon-reload
[Unit]
Description=PixiCDN Caddy
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy
PublishPort=80:80
PublishPort=443:443
Volume=/opt/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/opt/caddy/html:/srv:z
Volume=/opt/caddy/data:/data:Z
Volume=/opt/caddy/config:/config:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
