# ============================================
# PixiCDN Environment Configuration
# Copy ke .env dan isi nilai sebenarnya (.env di-gitignore).
# Kode membaca environment via getenv() dengan fallback ke
# config.php lalu config.example.php — TANPA dependensi phpdotenv.
# Nilai sensitif: tulis CHANGE_ME di sini, isi yang asli di .env.
# ============================================

# Application
APP_NAME=PixiCDN
APP_URL=https://pixicdn.erdtreeproject.my.id
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Database
DB_HOST=192.168.1.50
DB_PORT=3306
DB_NAME=pixicdn_db
DB_USER=pixicdn_user
DB_PASS=CHANGE_ME

# Object Storage (RustFS)
S3_ENDPOINT=http://192.168.1.50:9000
S3_BUCKET=pixicdn
S3_REGION=us-east-1
S3_KEY=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL=https://s3.erdtreeproject.my.id/pixicdn

# Session
SESSION_NAME=PIXICDN_SESSION
CSRF_TOKEN_KEY=csrf_token

# Upload
MAX_FILE_SIZE=5242880
MAX_FILES_PER_UPLOAD=5
