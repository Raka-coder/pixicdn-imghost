{
    "name": "pixicdn/pixicdn",
    "description": "PixiCDN - self-hosted image hosting with direct link",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "aws/aws-sdk-php": "^3.0"
    },
    "autoload": {
        "files": [
            "includes/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0"
    }
}
